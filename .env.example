# ============================================================
# E2E test-suite configuration — copy to `.env` and adjust.
# Конфигурация E2E-набора тестов — скопируйте в `.env` и поправьте.
# ============================================================
# `.env` is git-ignored; only `.env.example` lives in the repo.
# `.env` игнорируется гитом; в репозитории лежит только `.env.example`.

# --- Common / Общие -----------------------------------------
# Base URL of the application under test.
# Базовый URL тестируемого приложения.
# Default: demo subdomain — the FULL suite runs here, every test-only
# endpoint and the VK / YooKassa stubs are available.
# По умолчанию: demo-поддомен — полный набор гоняется именно там,
# доступны все тестовые эндпоинты и заглушки VK / ЮKassa.
BASE_URL=https://demo.alenaproyoga.ru/

# Optional: point at a local Django TEAM-test server instead (for a dev loop).
# Опционально: локальный тест-сервер вместо demo (для быстрой локальной итерации).
# BASE_URL=http://127.0.0.1:8003/

# --- Production smoke (playwright.prod.config.js, optional) --
# Optional read-only smoke against the LIVE app (alenaproyoga.ru).
# Dedicated users created on the LIVE application. Never reuse
# real client credentials here.
# Опциональный read-only смоук боевого приложения (alenaproyoga.ru).
# Выделенные пользователи на живом приложении. Никогда не
# используйте здесь реальные учётные данные клиентов.
PROD_USER_PHONE=+7XXXXXXXXXX
PROD_USER_PASSWORD=change-me