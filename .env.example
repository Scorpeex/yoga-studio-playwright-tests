# ============================================================
# E2E test-suite configuration — copy to `.env` and adjust.
# Конфигурация E2E-набора тестов — скопируйте в `.env` и поправьте.
# ============================================================
# `.env` is git-ignored; only `.env.example` lives in the repo.
# `.env` игнорируется гитом; в репозитории лежит только `.env.example`.

# --- Common / Общие -----------------------------------------
# Base URL of the application under test.
# Базовый URL тестируемого приложения.
# Local test-server (Django + seeded test DB) is used by default.
# По умолчанию используется локальный тест-сервер (Django + засеянная БД).
BASE_URL=http://127.0.0.1:8003/

# --- Production smoke (playwright.prod.config.js) -----------
# Dedicated users created on the LIVE application. Never reuse
# real client credentials here.
# Выделенные пользователи на БОЕВОМ приложении. Никогда не
# используйте здесь реальные учётные данные клиентов.
PROD_USER_PHONE=+7XXXXXXXXXX
PROD_USER_PASSWORD=change-me